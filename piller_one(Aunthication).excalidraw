      "updated": 1786353973271,
      "link": null,
      "locked": false,
      "text": "[ OtpView ] ──(1) submit──> handleOtpSuccess() ──(2)──> authService.verifyOtp()\n                                                               │\n                                                              (3) request('/auth/verify-otp')\n                                                               ▼\n[ MongoDB ] <──(5) update── verifyOtp() <──(4) route ── [ Express Router ]\n     │                         │\n     └──(6) verified user ─────┤\n                               ▼\n                        buildUserPayload()\n                               │\n                               ▼\n                        generateToken() ──(7) jwt.sign() ──> [ JWT Minted ]\n                                                                   │\n[ localStorage ] <──(9) persist ── (8) JSON { user, token } ───────┘",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[ OtpView ] ──(1) submit──> handleOtpSuccess() ──(2)──> authService.verifyOtp()\n                                                               │\n                                                              (3) request('/auth/verify-otp')\n                                                               ▼\n[ MongoDB ] <──(5) update── verifyOtp() <──(4) route ── [ Express Router ]\n     │                         │\n     └──(6) verified user ─────┤\n                               ▼\n                        buildUserPayload()\n                               │\n                               ▼\n                        generateToken() ──(7) jwt.sign() ──> [ JWT Minted ]\n                                                                   │\n[ localStorage ] <──(9) persist ── (8) JSON { user, token } ───────┘",
      "autoResize": true,
      "lineHeight": 1.25
    },
